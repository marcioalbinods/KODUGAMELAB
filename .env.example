# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# Use SOMENTE a chave pública "anon" (publishable). NUNCA coloque a service_role key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
# Caminho base ao publicar no GitHub Pages (opcional; o padrão './' funciona com HashRouter)
# VITE_BASE_PATH=/nome-do-repositorio/
